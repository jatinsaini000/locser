NODE_ENV=production
PORT=3000

# Set true only for local development with SQLite
USE_LOCAL_DB=false
# Set true for managed PostgreSQL that requires SSL (e.g. AWS RDS)
DB_SSL=true

# Required when USE_LOCAL_DB=false
# Example:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name
DATABASE_URL=

# Optional: comma-separated allowed origins for browser calls
# Example:
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=
